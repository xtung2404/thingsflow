<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/root"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/_space10dp"
        android:paddingHorizontal="@dimen/space_screen_super_small"
        android:clipToPadding="false"
        android:clipChildren="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <com.example.thingsflow.ui.customview.CheckBoxCustom
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:clickable="false"
                android:enabled="false"
                android:id="@+id/cb_configed"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginEnd="@dimen/space_screen_super_small">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/txt_label"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_body2"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/txt_location"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_overline"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="@dimen/_space4dp"/>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:id="@+id/btn_expand"
                android:padding="10dp"
                android:src="@drawable/ic_up" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/fl_control">
            <com.example.thingsflow.ui.customview.ViewControlOnOff
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/ln_control_on_off"/>
        </FrameLayout>


    </LinearLayout>
</layout>