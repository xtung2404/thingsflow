<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/root"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/_space10dp"
        android:paddingHorizontal="@dimen/space_screen_super_small"
        android:layout_marginBottom="@dimen/_space12dp"
        android:background="#FFF2F2F2">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_stroke_black"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_label"
                android:textColor="@color/black"
                android:textSize="@dimen/text_overline"
                android:maxLines="1"
                android:ellipsize="end"/>
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/edt_label"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/text_body2"
                android:background="@null"
                android:layout_marginTop="@dimen/_space4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/group_of_device"
            android:textColor="@color/black"
            android:textSize="@dimen/text_overline"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp"/>
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/spinner_group"
            android:background="@drawable/bg_text_input_gray"
            android:paddingHorizontal="13dp"
            android:paddingVertical="14dp"
            android:layout_marginTop="@dimen/_space10dp"/>
    </LinearLayout>
</layout>