<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_screen_super_small">
        <include layout="@layout/layout_toolbar"
            android:id="@+id/toolbar" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="45dp"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_space100dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_otp_code"
                android:fontFamily="@font/roboto_regular"
                android:textSize="@dimen/text_headline5"
                android:textColor="@color/black"
                android:layout_gravity="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/otp_code_will_be_sent_to_your_email"
                android:fontFamily="@font/roboto_regular"
                android:textSize="@dimen/text_body2"
                android:textColor="@color/black"
                android:layout_gravity="center"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:background="@drawable/bg_text_input_gray"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:hintEnabled="false"
                    android:paddingTop="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_text_input_gray"
                        android:paddingVertical="14dp"
                        android:hint="@string/insert_your_email"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:textSize="13sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/email"
                    android:textColor="@color/text_hint_color"
                    android:textSize="@dimen/text_caption"
                    android:paddingStart="15dp"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_screen_small">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_password_for"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/text_overline"
                    android:textColor="@color/black"
                    android:layout_marginEnd="@dimen/_space3dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/txt_email"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="10sp"
                    android:textColor="@color/indigo"/>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btn_continue"
                android:text="@string/confirm"
                android:fontFamily="@font/roboto_regular"
                android:textSize="@dimen/text_button"
                android:textColor="@color/white"
                android:paddingVertical="13dp"
                android:background="@drawable/btn_emerald"
                android:textAllCaps="false"
                android:layout_marginTop="60dp"/>
        </LinearLayout>
    </LinearLayout>
</layout>