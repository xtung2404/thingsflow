<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/space_screen_super_small"
        android:orientation="vertical"
        android:fitsSystemWindows="true">
        <include layout="@layout/layout_toolbar"
            android:id="@+id/toolbar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/cl_scanning"
            android:visibility="gone"
            android:paddingHorizontal="40dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_sub_device"
                    android:textSize="24sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_screen_small"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gateway_info"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/black"
                    android:layout_marginTop="12dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/gray"
                    android:paddingVertical="@dimen/_space12dp"
                    android:paddingHorizontal="@dimen/_space12dp"
                    android:layout_marginTop="@dimen/_space8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txt_label"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/black"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_space4dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/location_dot"
                                android:textSize="@dimen/text_overline"
                                android:textColor="@color/black"
                                android:layout_marginEnd="5dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/group_dot"
                                android:textSize="@dimen/text_overline"
                                android:textColor="@color/black"
                                android:layout_marginEnd="5dp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/txt_location"
                                android:text="@string/location"
                                android:textSize="@dimen/text_overline"
                                android:textColor="@color/black"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/txt_group"
                                android:textSize="@dimen/text_overline"
                                android:textColor="@color/black"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="@dimen/_space4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center_horizontal"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scanning_device"
                        android:id="@+id/txt_scanning"
                        android:textSize="@dimen/text_body2"
                        android:textColor="@color/black"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120s"
                        android:textStyle="bold"
                        android:id="@+id/txt_scanning_time"
                        android:textSize="@dimen/text_headline6"
                        android:textColor="@color/emerald"/>
                </LinearLayout>

            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="45dp"
            android:id="@+id/ln_select_device"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/ln_theme"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/devices_found"
                    android:textSize="@dimen/text_headline5"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_screen_small"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_screen_super_small"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/number_of_device_found"
                        android:textSize="@dimen/text_body2"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_space5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txt_device_found"
                        android:text="2"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_body2"
                        android:textColor="@color/emerald"
                        android:layout_gravity="center"/>
                </LinearLayout>

            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txt_available_devices"
                android:text="@string/list_of_device"
                android:textSize="@dimen/text_overline"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/space_screen_small"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/ln_devices"
                android:orientation="vertical">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_gateway"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_screen_super_small"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scanning_device"
                        android:textSize="@dimen/text_body2"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_space5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txt_scanning_time_2"
                        android:text="2"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_body2"
                        android:textColor="@color/emerald"
                        android:layout_gravity="center"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btn_continue"
                    android:text="@string/to_continue"
                    android:textSize="@dimen/text_button"
                    android:textColor="@color/white"
                    android:paddingVertical="13dp"
                    android:background="@color/emerald"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/space_screen_small"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>


        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btn_rescan"
            android:text="@string/rescan_device"
            android:textColor="@color/black"
            android:paddingVertical="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/bg_white_stroke_black"
            android:textAllCaps="false"
            android:layout_marginVertical="@dimen/space_screen_small"
            android:textSize="@dimen/text_button"
            android:layout_marginHorizontal="40dp"/>
    </LinearLayout>

</layout>