<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/overlay_box_event"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="visible"   />
        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@android:color/white"
            android:elevation="8dp"
            android:orientation="vertical"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/background_color">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_space16dp"
                    android:paddingTop="@dimen/_space30dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btn_back"
                        android:layout_width="@dimen/_space32dp"
                        android:layout_height="@dimen/_space32dp"
                        android:src="@drawable/ic_back"
                        android:background="@drawable/btn_gray"
                        android:padding="@dimen/_space4dp"
                        android:layout_marginEnd="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/box_action"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_body2"
                            android:fontFamily="@font/roboto_medium"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/control_device"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_headline6"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/control_one_or_multiple_devices"
                            android:textColor="@color/text_hint_color"
                            android:textSize="@dimen/text_caption"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginTop="12dp"/>
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.tabs.TabLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tab_layout_evt_device"
                    android:background="@color/background_color"
                    app:tabTextColor="@color/emerald"
                    android:textSize="@dimen/text_body2">
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input"/>
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config"/>
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/output"/>
                </com.google.android.material.tabs.TabLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/ln_input"
                android:paddingHorizontal="16dp"
                android:visibility="gone"
                android:layout_marginTop="30dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_screen_super_small"
                    android:text="@string/input_from_previous_box"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_caption" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray"
                    android:layout_marginTop="@dimen/_space8dp"
                    android:layout_marginBottom="4dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/rv_input_from_previous_box"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/ln_config"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_space16dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_space16dp"
                    android:visibility="visible"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_screen_super_small"
                        android:text="@string/control_action"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_caption" />

                    <Spinner
                        android:id="@+id/spinner_control_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_space10dp"
                        android:background="@drawable/bg_text_input_gray"
                        android:paddingHorizontal="13dp"
                        android:paddingVertical="14dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_screen_super_small"
                        android:text="@string/device_type"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_caption" />

                    <Spinner
                        android:id="@+id/spinner_device_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_space10dp"
                        android:background="@drawable/bg_text_input_gray"
                        android:paddingHorizontal="13dp"
                        android:paddingVertical="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_screen_super_small"
                        android:text="@string/select_device"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_caption" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_screen_super_small"
                        android:background="@color/gray" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.example.thingsflow.ui.customview.CheckBoxCustom
                            android:id="@+id/cb_later"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"/>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/later"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.example.thingsflow.ui.customview.CheckBoxCustom
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:id="@+id/cb_select_device"
                            android:button="@drawable/custom_checkbox_emerald"
                            android:layout_marginEnd="8dp"/>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ln_empty_devices"
                                android:visibility="gone"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:background="@color/light_gray">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/choose_device_from_list"
                                    android:textSize="@dimen/text_caption"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textColor="@color/black"
                                    android:paddingStart="@dimen/space_screen_super_small"
                                    android:paddingVertical="10dp"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_note"
                                    android:padding="8dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ln_devices"
                                android:visibility="visible"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:id="@+id/txt_number_of_devices"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_body2"
                                        android:textStyle="bold"
                                        android:maxLines="1"
                                        android:ellipsize="end"/>
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:padding="10dp"
                                        android:id="@+id/btn_select_device"
                                        android:src="@drawable/ic_add_circle"/>
                                </LinearLayout>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/rv_devices"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btn_create_box"
                    android:text="@string/create_box_and_config"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_button"
                    android:textColor="@color/white"
                    android:background="@color/emerald"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="@dimen/_space48dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btn_close"
                    android:text="@string/close"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_button"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_gray"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/ln_output"
                android:paddingHorizontal="16dp"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/ln_output_empty"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_of_output_can_be_used_in_the_next_box"
                        android:textColor="@color/text_hint_color"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginTop="12dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_screen_small"
                        android:background="@color/gray" />
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="40dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/output_will_be_available_after_being_configed"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_body2"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginTop="18dp"
                        android:layout_gravity="center_horizontal"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_output_config"
                        android:text="@string/config_device"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_button"
                        android:textColor="@color/white"
                        android:background="@color/emerald"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="@dimen/_space48dp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_output_close"
                        android:text="@string/close"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_button"
                        android:textColor="@color/white"
                        android:background="@drawable/btn_gray"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:id="@+id/ln_output_config"
                    android:orientation="vertical"
                    android:layout_marginVertical="20dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:layout_width="@dimen/_space32dp"
                            android:layout_height="@dimen/_space32dp"
                            android:id="@+id/cb_forward_json"
                            android:button="@drawable/custom_checkbox_emerald"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/forward_json"
                            android:textColor="@color/black"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <CheckBox
                            android:layout_width="@dimen/_space32dp"
                            android:layout_height="@dimen/_space32dp"
                            android:id="@+id/cb_export_value"
                            android:button="@drawable/custom_checkbox_emerald"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/export_value_form"
                            android:textColor="@color/black"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_config_output"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_white_stroke_black"
                        android:paddingHorizontal="8dp"
                        android:text="@string/required_output"
                        android:textColor="@color/emerald"
                        android:textSize="@dimen/text_button" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray"
                        android:layout_marginTop="20dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/output_value"
                            android:textColor="@color/black"
                            android:textSize="13sp"/>

                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/ln_output_table"
                            android:orientation="vertical">

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/ln_output_json"
                            android:orientation="vertical">

                        </LinearLayout>
                    </FrameLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_output_config_close"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_gray"
                        android:paddingHorizontal="8dp"
                        android:text="@string/close"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_button" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</layout>