<?xml version="1.0" encoding="utf-8"?>
   <navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.thingsflow.ui.FragmentSplash"
        android:label="SplashFragment" >
        <action
            android:id="@+id/action_splashFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.thingsflow.ui.authentication.FragmentSignIn"
        android:label="SignInFragment" >
        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signInFragment_to_resetPasswordFragment"
            app:destination="@id/resetPasswordFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.thingsflow.ui.authentication.FragmentSignUp"
        android:label="SignUpFragment" >
        <action
            android:id="@+id/action_signUpFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_signUpFragment_to_verifyOTPFragment"
            app:destination="@id/verifyOTPFragment" />
    </fragment>
    <fragment
        android:id="@+id/verifyOTPFragment"
        android:name="com.example.thingsflow.ui.authentication.FragmentVerifyOTP"
        android:label="VerifyOTPFragment" />
    <fragment
        android:id="@+id/locationManagementFragment"
        android:name="com.example.thingsflow.ui.deviceConfig.gateway.FragmentLocationManagement"
        android:label="LocationManagementFragment" >
        <action
            android:id="@+id/action_locationManagementFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_locationManagementFragment_to_createLocationFragment"
            app:destination="@id/createLocationFragment" />
        <action
            android:id="@+id/action_locationManagementFragment_to_identifyDeviceFragment"
            app:destination="@id/identifyDeviceFragment" />
        <action
            android:id="@+id/action_locationManagementFragment_to_fragmentSelectZigbeeGateway"
            app:destination="@id/fragmentSelectZigbeeGateway" />
        <action
            android:id="@+id/action_locationManagementFragment_to_homeFragment2"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/createLocationFragment"
        android:name="com.example.thingsflow.ui.location.FragmentCreateLocation"
        android:label="CreateLocationFragment" />
    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.example.thingsflow.ui.authentication.FragmentResetPassword"
        android:label="ResetPasswordFragment" >
        <action
            android:id="@+id/action_resetPasswordFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_resetPasswordFragment_to_verifyResetPwdOtpFragment"
            app:destination="@id/verifyResetPwdOtpFragment" />
    </fragment>
    <fragment
        android:id="@+id/verifyResetPwdOtpFragment"
        android:name="com.example.thingsflow.ui.authentication.FragmentVerifyResetPwdOtp"
        android:label="VerifyResetPwdOtpFragment" >
        <action
            android:id="@+id/action_verifyResetPwdOtpFragment_to_resetPasswordFragment"
            app:destination="@id/resetPasswordFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.thingsflow.ui.FragmentDashboard"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_fragmentFlowScenManagement"
            app:destination="@id/fragmentFlowScenManagement" />
        <action
            android:id="@+id/action_homeFragment_to_fragmentDevice"
            app:destination="@id/fragmentDevice" />
        <action
            android:id="@+id/action_homeFragment_to_locationManagementFragment"
            app:destination="@id/locationManagementFragment" />
        <action
            android:id="@+id/action_homeFragment_to_locationManagementFragment2"
            app:destination="@id/locationManagementFragment" />
    </fragment>
    <fragment
        android:id="@+id/identifyDeviceFragment"
        android:name="com.example.thingsflow.ui.deviceConfig.gateway.FragmentIdentifyDevice"
        android:label="IdentifyDeviceFragment" >
        <action
            android:id="@+id/action_identifyDeviceFragment_to_configWiFiFragment"
            app:destination="@id/configWiFiFragment" />
    </fragment>
    <fragment
        android:id="@+id/configWiFiFragment"
        android:name="com.example.thingsflow.ui.deviceConfig.gateway.FragmentConfigWiFi"
        android:label="ConfigWiFiFragment" >
        <action
            android:id="@+id/action_configWiFiFragment_to_fragmentConfigGateway"
            app:destination="@id/fragmentConfigGateway" />
    </fragment>
    <fragment
        android:id="@+id/fragmentFlowScenManagement"
        android:name="com.example.thingsflow.ui.flowScene.FragmentFlowScenManagement"
        android:label="FragmentFlowScenManagement" >
        <action
            android:id="@+id/action_fragmentFlowScenManagement_to_fragmentFlowScenario"
            app:destination="@id/fragmentFlowScenario" />
        <action
            android:id="@+id/action_fragmentFlowScenManagement_to_fragmentCreateFlowScenario"
            app:destination="@id/fragmentCreateFlowScenario" />
        <action
            android:id="@+id/action_fragmentFlowScenManagement_to_fragmentFlowScenarioInfo"
            app:destination="@id/fragmentFlowScenarioInfo" />
    </fragment>
     <fragment
        android:id="@+id/fragmentFlowScenario"
        android:name="com.example.thingsflow.ui.flowScene.fragmentFlowScenario.FragmentFlowScenario"
        android:label="FragmentFlowScenario" >
         <action
             android:id="@+id/action_fragmentFlowScenario_to_fragmentFlowScenManagement"
             app:destination="@id/fragmentFlowScenManagement" />
     </fragment>
    <fragment
        android:id="@+id/fragmentCreateFlowScenario"
        android:name="com.example.thingsflow.ui.flowScene.FragmentCreateFlowScenario"
        android:label="FragmentCreateFlowScenario" >
        <action
            android:id="@+id/action_fragmentCreateFlowScenario_to_fragmentFlowScenManagement"
            app:destination="@id/fragmentFlowScenManagement" />
    </fragment>
    <fragment
        android:id="@+id/fragmentFlowScenarioInfo"
        android:name="com.example.thingsflow.ui.flowScene.FragmentFlowScenarioInfo"
        android:label="FragmentFlowScenarioInfo" >
        <action
            android:id="@+id/action_fragmentFlowScenarioInfo_to_fragmentFlowScenManagement"
            app:destination="@id/fragmentFlowScenManagement" />
        <action
            android:id="@+id/action_fragmentFlowScenarioInfo_to_fragmentFlowScenario"
            app:destination="@id/fragmentFlowScenario" />
        <action
            android:id="@+id/action_fragmentFlowScenarioInfo_to_identifyDeviceFragment"
            app:destination="@id/identifyDeviceFragment" />
        <action
            android:id="@+id/action_fragmentFlowScenarioInfo_to_fragmentFlowBinding"
            app:destination="@id/fragmentFlowBinding" />
    </fragment>
    <fragment
        android:id="@+id/fragmentDevice"
        android:name="com.example.thingsflow.ui.device.FragmentDevice"
        android:label="FragmentDevice" >
        <action
            android:id="@+id/action_fragmentDevice_to_fragmentDeviceDetail"
            app:destination="@id/fragmentDeviceDetail" />
        <action
            android:id="@+id/action_fragmentDevice_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_fragmentDevice_to_fragmentSelectZigbeeGateway"
            app:destination="@id/fragmentSelectZigbeeGateway" />
        <action
            android:id="@+id/action_fragmentDevice_to_identifyDeviceFragment"
            app:destination="@id/identifyDeviceFragment" />
    </fragment>
    <fragment
        android:id="@+id/fragmentDeviceDetail"
        android:name="com.example.thingsflow.ui.device.FragmentDeviceDetail"
        android:label="FragmentDeviceDetail" >
        <action
            android:id="@+id/action_fragmentDeviceDetail_to_fragmentDevice"
            app:destination="@id/fragmentDevice" />
    </fragment>
    <fragment
        android:id="@+id/fragmentSelectZigbeeGateway"
        android:name="com.example.thingsflow.ui.deviceConfig.zigbee.FragmentSelectZigbeeGateway"
        android:label="FragmentSelectZigbeeGateway" >
        <action
            android:id="@+id/action_fragmentSelectZigbeeGateway_to_fragmentIdentifyZigbeeDevice"
            app:destination="@id/fragmentIdentifyZigbeeDevice" />
    </fragment>
    <fragment
        android:id="@+id/fragmentIdentifyZigbeeDevice"
        android:name="com.example.thingsflow.ui.deviceConfig.zigbee.FragmentIdentifyZigbeeDevice"
        android:label="FragmentIdentifyZigbeeDevice" >
        <action
            android:id="@+id/action_fragmentIdentifyZigbeeDevice_to_fragmentSelectPairedZigbee"
            app:destination="@id/fragmentSelectPairedZigbee" />
        <action
            android:id="@+id/action_fragmentIdentifyZigbeeDevice_to_fragmentSelectZigbeeGateway"
            app:destination="@id/fragmentSelectZigbeeGateway" />
    </fragment>
    <fragment
        android:id="@+id/fragmentConfigGateway"
        android:name="com.example.thingsflow.ui.deviceConfig.gateway.FragmentConfigGateway"
        android:label="FragmentConfigGateway" >
        <action
            android:id="@+id/action_fragmentConfigGateway_to_fragmentDevice"
            app:destination="@id/fragmentDevice" />
    </fragment>
    <fragment
        android:id="@+id/fragmentSelectPairedZigbee"
        android:name="com.example.thingsflow.ui.deviceConfig.zigbee.FragmentSelectPairedZigbee"
        android:label="FragmentSelectPairedZigbee" >
        <action
            android:id="@+id/action_fragmentSelectPairedZigbee_to_fragmentConfigZigbeeDevices"
            app:destination="@id/fragmentConfigZigbeeDevices" />
        <action
            android:id="@+id/action_fragmentSelectPairedZigbee_to_fragmentSelectZigbeeGateway"
            app:destination="@id/fragmentSelectZigbeeGateway" />
    </fragment>
    <fragment
        android:id="@+id/fragmentConfigZigbeeDevices"
        android:name="com.example.thingsflow.ui.deviceConfig.zigbee.FragmentConfigZigbeeDevices"
        android:label="FragmentConfigZigbeeDevices" >
        <action
            android:id="@+id/action_fragmentConfigZigbeeDevices_to_fragmentSyncZigbeeDevices"
            app:destination="@id/fragmentSyncZigbeeDevices" />
        <action
            android:id="@+id/action_fragmentConfigZigbeeDevices_to_fragmentSelectZigbeeGateway"
            app:destination="@id/fragmentSelectZigbeeGateway" />
    </fragment>
     <fragment
        android:id="@+id/fragmentSyncZigbeeDevices"
        android:name="com.example.thingsflow.ui.deviceConfig.zigbee.FragmentSyncZigbeeDevices"
        android:label="FragmentSyncZigbeeDevices" >
        <action
            android:id="@+id/action_fragmentSyncZigbeeDevices_to_fragmentDevice"
            app:destination="@id/fragmentDevice" />
    </fragment>
    <fragment
        android:id="@+id/fragmentFlowBinding"
        android:name="com.example.thingsflow.ui.flowbinding.FragmentFlowBinding"
        android:label="FragmentFlowBinding" />
</navigation>